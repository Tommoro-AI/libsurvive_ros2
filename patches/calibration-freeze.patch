+SURVIVE_EXPORT bool survive_freeze_calibration(SurviveContext *ctx) {
+	if (!ctx)
+		return false;
+	survive_get_ctx_lock(ctx);
+	bool calibrated = false;
+	for (int i = 0; i < ctx->activeLighthouses; i++)
+		calibrated |= !ctx->bsd[i].disable && ctx->bsd[i].PositionSet && ctx->bsd[i].OOTXSet;
+	if (!calibrated) {
+		survive_release_ctx_lock(ctx);
+		return false;
+	}
+	ctx->calibration_frozen = true;
+	survive_release_ctx_lock(ctx);
+	DeviceDriver freeze = (DeviceDriver)GetDriver("FreezeGlobalSceneSolver");
+	if (freeze)
+		freeze(ctx);
+	return true;
+}
