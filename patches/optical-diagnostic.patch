+static void record_optical_diagnostic(const survive_optimizer *optimizer, int status,
+									  const struct async_optimizer_user *user, bool solve_attempted) {
+	SurviveObject *so = user->d->opt.so;
+	if (!so->optical_diagnostic) return;
+	SurviveOpticalDiagnostic next = *so->optical_diagnostic;
+	next.sequence++;
+	next.timecode = user->pdl.hdr.timecode;
+	next.solver_status = status;
+	next.fitting_lighthouses = user->canPossiblySolveLHS;
+	next.residual_count = optimizer->stats.sensor_error_cnt > 0 ? optimizer->stats.sensor_error_cnt : 0;
+	next.rms_rad = next.residual_count && isfinite(optimizer->stats.sensor_error) &&
+		optimizer->stats.sensor_error >= 0 ? sqrt(optimizer->stats.sensor_error / next.residual_count) : NAN;
+	next.window_seconds = so->timebase_hz > 0 ? user->stats.time_window / (FLT)so->timebase_hz : NAN;
+	// Scene construction advances this time past the triggering SYNC when newer observations exist.
+	const FLT reference_time = so->timebase_hz > 0 ? next.timecode / (FLT)so->timebase_hz : NAN;
+	next.max_age_seconds = isfinite(reference_time) ? 0 : NAN;
+	memset(next.axis_count, 0, sizeof(next.axis_count));
+	for (size_t i = 0; i < optimizer->measurementsCnt; ++i) {
+		const survive_optimizer_measurement *measurement = optimizer->measurements + i;
+		if (measurement->meas_type != survive_optimizer_measurement_type_light || measurement->invalid)
+			continue;
+		if (measurement->light.lh < NUM_GEN2_LIGHTHOUSES && measurement->light.axis < 2)
+			next.axis_count[2 * measurement->light.lh + measurement->light.axis]++;
+		FLT age = reference_time - measurement->time;
+		if (!isfinite(age) || age < 0) next.max_age_seconds = NAN;
+		else if (age > next.max_age_seconds) next.max_age_seconds = age;
+	}
+	next.fits++;
+	next.dropped_measurements += optimizer->stats.dropped_meas_cnt;
+	next.dropped_lighthouses += optimizer->stats.dropped_lh_cnt;
+	next.failed_fits += solve_attempted && status <= 0;
+	next.invalid_fits += solve_attempted && !isfinite(next.rms_rad);
+	if (isfinite(next.rms_rad) && (next.peak_residual_count == 0 || next.rms_rad > next.peak_rms_rad)) {
+		next.peak_rms_rad = next.rms_rad;
+		next.peak_residual_count = next.residual_count;
+		next.peak_lighthouse_count = 0;
+		for (int lh = 0; lh < NUM_GEN2_LIGHTHOUSES; ++lh)
+			next.peak_lighthouse_count += next.axis_count[2 * lh] > 0 && next.axis_count[2 * lh + 1] > 0;
+	}
+	*so->optical_diagnostic = next;
+}
